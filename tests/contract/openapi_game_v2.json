            "description": "Successful Response"
          }
        },
        "summary": "List Sections",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/story": {
      "get": {
        "description": "The company, its chapters and stages with their served question counts.",
        "operationId": "get_story_v2_game_story_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStory"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Story",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/search/game-questions": {
      "get": {
        "description": "Served questions matching `q`, best first, without their answer key. To play one,\nadd it to a round with `POST /v2/game/rounds/{round_id}/questions`.",
        "operationId": "search_cards_v2_search_game_questions_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 2000,
              "minLength": 2,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "section",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 200,
              "title": "Section",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "assessment_type",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 100,
              "title": "Assessment Type",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCardList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Cards",
        "tags": [
          "game v2"
        ]
      },
      "post": {
        "description": "`GET /v2/search/game-questions` with the fields in a JSON body.",
        "operationId": "search_cards_by_body_v2_search_game_questions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCardList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Cards By Body",
        "tags": [
          "game v2"
        ]
      }
    }
  },
