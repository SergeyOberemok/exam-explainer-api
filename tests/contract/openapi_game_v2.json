{
  "paths": {
    "/v2/game/objectives": {
      "get": {
        "description": "The objective catalog with how many served questions each objective has.",
        "operationId": "list_objectives_v2_game_objectives_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameObjectiveList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Objectives",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/questions": {
      "get": {
        "description": "Served questions without their answer keys. To play, start a round.",
        "operationId": "list_questions_v2_game_questions_get",
        "parameters": [
          {
            "in": "query",
            "name": "count",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "Count",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "section",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Section"
            }
          },
          {
            "in": "query",
            "name": "assessment_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Assessment Type"
            }
          },
          {
            "in": "query",
            "name": "shuffle",
            "required": false,
            "schema": {
              "default": true,
              "title": "Shuffle",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCardList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Questions",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/questions/{question_id}": {
      "get": {
        "operationId": "get_question_v2_game_questions__question_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "question_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{24}$",
              "title": "Question Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCard"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Question",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/rounds": {
      "post": {
        "description": "Start a round of composed questions (the same filters as `/v1/game/rounds`). 404\n`no_questions` when nothing matches.",
        "operationId": "create_round_v2_game_rounds_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameRoundRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCardRound"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Round",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/rounds/{round_id}/answers": {
      "post": {
        "description": "Answer one question of a round, once: the outcome of that answer, the review and\nthe resolved flow. The same answer again repeats the result; another one is 409\n`already_answered`.",
        "operationId": "answer_round_question_v2_game_rounds__round_id__answers_post",
        "parameters": [
          {
            "in": "path",
            "name": "round_id",
            "required": true,
            "schema": {
              "title": "Round Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameAnswerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCardAnswerResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Answer Round Question",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/rounds/{round_id}/answers/{question_id}": {
      "get": {
        "description": "The answer the round recorded for a question (404 `question_not_answered`).",
        "operationId": "get_round_answer_v2_game_rounds__round_id__answers__question_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "question_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{24}$",
              "title": "Question Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "round_id",
            "required": true,
            "schema": {
              "title": "Round Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCardAnswerResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Round Answer",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/rounds/{round_id}/batches": {
      "post": {
        "description": "The round's next questions, none already in it; asking for an existing batch\nreturns it again.",
        "operationId": "next_round_batch_v2_game_rounds__round_id__batches_post",
        "parameters": [
          {
            "in": "path",
            "name": "round_id",
            "required": true,
            "schema": {
              "title": "Round Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameRoundBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCardBatch"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Next Round Batch",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/rounds/{round_id}/fifty-fifty": {
      "post": {
        "description": "Remove two random wrong answers (tools) from an unanswered question.",
        "operationId": "use_round_fifty_fifty_v2_game_rounds__round_id__fifty_fifty_post",
        "parameters": [
          {
            "in": "path",
            "name": "round_id",
            "required": true,
            "schema": {
              "title": "Round Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameFiftyFiftyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameFiftyFiftyResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Use Round Fifty Fifty",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/rounds/{round_id}/questions": {
      "post": {
        "description": "Add a served question (a search result) to the round. 404 `question_not_found`\nfor an unknown id, 422 `question_not_playable` for one the game does not serve.",
        "operationId": "add_round_question_v2_game_rounds__round_id__questions_post",
        "parameters": [
          {
            "in": "path",
            "name": "round_id",
            "required": true,
            "schema": {
              "title": "Round Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameRoundQuestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCardRoundQuestion"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add Round Question",
        "tags": [
          "game v2"
        ]
      }
    },
    "/v2/game/sections": {
      "get": {
